# Contoh variabel lingkungan Backend (Student Learning Assistant).
# Salin berkas ini menjadi `.env` lalu isi nilainya. JANGAN menaruh nilai rahasia
# di berkas .env.example ini.

# Port server HTTP. Opsional — default 3001 bila tidak disetel.
PORT=3001

# Origin Frontend yang diizinkan CORS (wajib). Contoh: http://localhost:5173
FRONTEND_ORIGIN=

# Region AWS tempat layanan Bedrock dipanggil (wajib). Contoh: us-east-1
AWS_REGION=

# ID model Bedrock yang akan dipanggil (wajib).
BEDROCK_MODEL_ID=

# Kredensial AWS (kondisional). Mengikuti default credential provider chain
# AWS SDK (env, shared config, IAM role). Isi hanya bila memakai kredensial
# statis lewat environment; biarkan kosong bila memakai profil/role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
